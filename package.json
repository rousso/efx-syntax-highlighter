    "@lezer/common": "^1.0.0"
  },
  "devDependencies": {
    "@lezer/generator": "^1.3.0",
    "antlr-ng": "1.0.10",
    "antlr4ng": "3.0.16"
  },
  "config": {
    "sdk": "rousso/eForms-SDK@efc9a2116e752e2eed79b8a7391749bd69da060b",
    "toolkit": "rousso/efx-toolkit-java@8675b8af21416f259fc7fa1a93b86f282b2abaa5"
  }
